# Konfigurasi 9Router Sinkronisasi
ROUTER_BASE_URL=https://router.aestc.id
ROUTER_API_KEY=your_9router_api_key_here

# CATATAN: Telegram TIDAK dikonfigurasi lewat .env.
# api_id/api_hash + session per akun Telegram ada di
# config/telegram_accounts.json (lihat telegram_accounts.example.json).

# Farm multi-instance (1 akun freemodel = 1 akun Telegram)
FM_BASE_URL=https://freemodel.in
FM_TIMEOUT=90
FM_RETRIES=3
FM_CONCURRENCY=1
FM_TEST_MODEL=claude-mythos-preview
FM_EMAIL_DOMAIN=gmail.com
# Uji end-to-end melawan mock server lokal (tanpa menyentuh freemodel.in):
# FM_MOCK_MODE=1
# FM_MOCK_TG_ENDPOINT=http://127.0.0.1:8791/tg/claim
